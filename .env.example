# Kiro Manager configuration.
# Copy this file to ".env" (same directory) and edit the values:
#     cp .env.example .env
# Then start with:  docker compose up -d --build
#
# Lines starting with # are comments. Do NOT wrap values in quotes.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Port exposed on the host (what you open in the browser / point clients at).
HOST_PORT=8080

# Port the app listens on inside the container. Usually leave as 8080;
# HOST_PORT is mapped to this.
PORT=8080

# Bind address inside the container. Keep 0.0.0.0 so the mapped port works.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Security (leave blank to run open — only safe on a trusted/local network)
# ---------------------------------------------------------------------------

# If set, the management UI/API require this token:
#   - as ?token=<value> in the UI URL, or
#   - as the X-Admin-Token header on /api/* calls.
ADMIN_TOKEN=

# If set, the OpenAI proxy (/v1/*) requires: Authorization: Bearer <value>
API_KEY=

# ---------------------------------------------------------------------------
# Kiro backend (advanced — defaults are correct for most users)
# ---------------------------------------------------------------------------

# Runtime endpoint the proxy calls.
KIRO_ENDPOINT=https://runtime.us-east-1.kiro.dev

# Request origin sent to Kiro.
KIRO_ORIGIN=KIRO_CLI

# Where the app looks for a cached profile ARN INSIDE the container.
# Only relevant if you also mount a host .kiro (see KIRO_HOME_HOST below).
KIRO_HOME=/root/.kiro

# ---------------------------------------------------------------------------
# Optional: auto-discover the profile ARN from a host kiro-cli install
# ---------------------------------------------------------------------------
# Absolute path to your host ~/.kiro directory. If you set this, ALSO uncomment
# the matching volume line in docker-compose.yml. Otherwise just paste the
# Profile ARN in the UI when adding an account and ignore this.
#   Linux/macOS example: /home/you/.kiro   or   /Users/you/.kiro
#   Windows example:     C:/Users/you/.kiro
KIRO_HOME_HOST=
